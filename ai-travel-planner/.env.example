# ============================================================
# AI 旅行攻略生成器 · 环境变量示例
# 复制为 .env.local 后按需修改。真实密钥不要提交到任何仓库。
# ============================================================

# ---------- 大模型(D 决策记录 D-27 / D-28 / D-33)----------
# mock = 不调用真实模型；推荐搜索会提示切换 live
# live = 真实调用 DeepSeek API
LLM_MODE=mock

# 模型 ID(做成配置项,便于零代码切换 deepseek-v4-pro)
LLM_MODEL=deepseek-v4-flash

# DeepSeek API Key。留空时会自动尝试从 ~/.dsh/.credentials.yaml 读取(本机开发便利)
# 生产环境请务必通过环境变量注入,不要写进代码或文档
DEEPSEEK_API_KEY=

# 接口地址(OpenAI 兼容协议)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 默认推荐：DeepSeek Search / Fetch（仅服务端）----------
# 与模型调用复用 DEEPSEEK_API_KEY，不需要 MediaCrawler 或小红书登录
# 工具基础地址（不要附加 /v1/tools/search）
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
# 每次搜索返回数量：1..20，默认 8（项目上限比官方接口收紧）
SEARCH_RESULT_COUNT=8
# 单轮正文获取上限：0..6，默认 3
SEARCH_MAX_FETCH=3
# 缺类别或缺点评价补搜上限：0..3，默认 3
SEARCH_MAX_EXTRA_QUERIES=3

# 思考强度:该模型仅支持 high / max(low / medium 不支持)
LLM_THINKING=high

# ---------- 数据库(D-30)----------
DATABASE_URL=./data/app.db

# ---------- 小红书采集（保留能力；默认推荐不使用）----------
# 单独运行采集时仅支持有浏览器和登录状态的本机环境
# 默认使用相邻目录 ../MediaCrawler 和其 .venv/bin/python
# MEDIA_CRAWLER_DIR=/absolute/path/to/MediaCrawler
# MEDIA_CRAWLER_PYTHON=/absolute/path/to/python

# ---------- 应用 ----------
# 管理员邮箱白名单以外,role 字段为 admin 的用户可访问 /admin
NEXT_PUBLIC_APP_NAME=AI 旅行攻略生成器
