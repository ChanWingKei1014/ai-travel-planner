# ============================================================
# AI 旅行攻略生成器 · 环境变量示例
# 复制为 .env.local 后按需修改。真实密钥不要提交到任何仓库。
# ============================================================

# ---------- 大模型(D 决策记录 D-27 / D-28 / D-33)----------
# mock = 不调用真实模型；小红书搜索词与内容整理需要 live 模式
# live = 真实调用 DeepSeek API
LLM_MODE=mock

# 模型 ID(做成配置项,便于零代码切换 deepseek-v4-pro)
LLM_MODEL=deepseek-v4-flash

# DeepSeek API Key。留空时会自动尝试从 ~/.dsh/.credentials.yaml 读取(本机开发便利)
# 生产环境请务必通过环境变量注入,不要写进代码或文档
DEEPSEEK_API_KEY=

# 接口地址(OpenAI 兼容协议)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 思考强度:该模型仅支持 high / max(low / medium 不支持)
LLM_THINKING=high

# ---------- 数据库(D-30)----------
DATABASE_URL=./data/app.db

# ---------- 小红书采集（仅支持有浏览器和登录状态的本机运行）----------
# 默认使用相邻目录 ../MediaCrawler 和其 .venv/bin/python
# MEDIA_CRAWLER_DIR=/absolute/path/to/MediaCrawler
# MEDIA_CRAWLER_PYTHON=/absolute/path/to/python

# ---------- 应用 ----------
# 管理员邮箱白名单以外,role 字段为 admin 的用户可访问 /admin
NEXT_PUBLIC_APP_NAME=AI 旅行攻略生成器
